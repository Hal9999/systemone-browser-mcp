SYSTEMONE_URL=http://host.docker.internal:8888/v1/systemone
SYSTEMONE_API_KEY=replace-me
SYSTEMONE_MODEL=laya
OPENAI_BASE_URL=http://host.docker.internal:8888/v1
OPENAI_API_KEY=replace-me
TEXT_MODEL=your-loaded-text-model
HEADLESS=true
LOG_LEVEL=info

# Optional backend context budgets; leave unset to use server defaults.
# SYSTEMONE_MAX_LEN=8192
# SYSTEMONE_HEAD_MAX_LEN=2048
RUN_TIMEOUT_MS=100000
SCREENSHOTS_ENABLED=false
ARTIFACTS_DIR=/app/artifacts
