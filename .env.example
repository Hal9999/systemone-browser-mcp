SYSTEMONE_URL=http://host.docker.internal:8888/v1/systemone
SYSTEMONE_API_KEY=replace-me
SYSTEMONE_MODEL=laya
OPENAI_BASE_URL=http://host.docker.internal:8888/v1
OPENAI_API_KEY=replace-me
TEXT_MODEL=your-loaded-text-model
HEADLESS=true
LOG_LEVEL=info
# Human-readable Docker logs; use json for structured collection.
LOG_FORMAT=pretty
# Force ANSI colors because MCP stdio containers do not allocate a TTY.
LOG_COLOR=always

# Optional backend context budgets; leave unset to use server defaults.
# SYSTEMONE_MAX_LEN=8192
# SYSTEMONE_HEAD_MAX_LEN=2048
RUN_TIMEOUT_MS=100000
SCREENSHOTS_ENABLED=false
ARTIFACTS_DIR=/app/artifacts
ARTIFACTS_TIMEZONE=Europe/Rome
# Bounded load/hydration settling before observations and executed screenshots.
PAGE_READY_MIN_MS=2000
PAGE_READY_STABLE_MS=750
PAGE_READY_TIMEOUT_MS=20000
