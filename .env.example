# Internal Laya runs on CPU; endpoint/model/max_len are set by the entrypoint.
# Text generation continues to use Unsloth:
OPENAI_BASE_URL=http://host.docker.internal:8888/v1
OPENAI_API_KEY=replace-me
TEXT_MODEL=your-loaded-text-model
HEADLESS=true
LOG_LEVEL=debug
LAYA_THREADS=6
LAYA_STARTUP_TIMEOUT=900
SYSTEMONE_HEAD_MAX_LEN=2048
RUN_TIMEOUT_MS=300000

SCREENSHOTS_ENABLED=false
ARTIFACTS_DIR=/app/artifacts
